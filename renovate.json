{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "pruneStaleBranches": true,
  "timezone": "America/New_York",
  "ignorePaths": [],
  "assignees": [
    "d90"
  ],
  "automerge": true,
  "automergeType": "pr",
  "kubernetes": {
    "managerFilePatterns": [
      "/^home\\/(apps|core)\\/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Never automerge major updates - leave these for manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major-update"
      ]
    },
    {
      "matchPackageNames": [
        "/linuxserver/"
      ],
      "labels": [
        "lsio"
      ]
    },
    {
      "matchPackageNames": [
        "/.*arr$/"
      ],
      "addLabels": [
        "media-stack"
      ]
    },
    {
      "matchPackageNames": [
        "/fluxcd/"
      ],
      "addLabels": [
        "fluxcd"
      ]
    },
    {
      "description": "Update tdarr server and node together so their versions stay in sync",
      "matchPackageNames": [
        "/haveagitgat\\/tdarr/"
      ],
      "groupName": "tdarr (server + node)"
    },
    {
      "groupName": "cert-manager (chart + CRDs)",
      "matchManagers": [
        "flux",
        "custom.regex"
      ],
      "matchPackageNames": [
        "/cert-manager/"
      ]
    },
    {
      "description": "Group FluxCD non-major updates",
      "matchManagers": [
        "flux"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "fluxcd non-major updates",
      "groupSlug": "fluxcd-non-major",
      "addLabels": [
        "fluxcd"
      ]
    },
    {
      "description": "CNPG operator: never automerge; one PR per minor (upstream recommends upgrading one minor at a time). Every bump rolls all Postgres instances.",
      "matchDepNames": [
        "cloudnative-pg/cloudnative-pg"
      ],
      "automerge": false,
      "separateMultipleMinor": true,
      "addLabels": [
        "cnpg"
      ],
      "prBodyNotes": [
        "Upgrade one minor at a time and read https://cloudnative-pg.io/documentation/current/installation_upgrade/ for every intermediate minor. Take fresh pg_dump backups first; merging rolls every Postgres instance."
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)kustomization\\.ya?ml$/"
      ],
      "matchStrings": [
        "https://github\\.com/cert-manager/cert-manager/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/cert-manager\\.crds\\.yaml"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cert-manager/cert-manager"
    },
    {
      "customType": "regex",
      "description": "CloudNativePG operator release manifest (version appears in both the branch and file name)",
      "managerFilePatterns": [
        "/(^|/)kustomization\\.ya?ml$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/cloudnative-pg/cloudnative-pg/release-\\d+\\.\\d+/releases/cnpg-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.yaml"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cloudnative-pg/cloudnative-pg",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "autoReplaceStringTemplate": "https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/release-{{{replace '\\.\\d+$' '' newValue}}}/releases/cnpg-{{{newValue}}}.yaml"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)helmrelease\\.ya?ml$/"
      ],
      "matchStrings": [
        "chart:\\s*\\n\\s+spec:\\s*\\n\\s+chart:\\s+(?<depName>[\\w-]+)\\s*\\n\\s+version:\\s+\"(?<currentValue>[^\"]+)\"[^\\n]*\\n\\s+sourceRef:\\s*\\n\\s+kind:\\s+HelmRepository\\s*\\n\\s+name:\\s+tc-truecharts"
      ],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://oci.trueforge.org",
      "packageNameTemplate": "truecharts/{{depName}}"
    }
  ]
}
